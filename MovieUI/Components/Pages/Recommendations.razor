@page "/recommendations"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Http
@using Microsoft.ML.Data
@using MovieDLL.Models
@using Services
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@inject IMovieService _db
@inject IRatingService _dbRating
@inject IJSRuntime JS
@inject IHttpContextAccessor httpContextAccessor

<PageTitle>Recommendations</PageTitle>

<AuthorizeView>
	<Authorized>
		<h3>Rate Movies</h3>

		<div class="mb-2">
			<input type="text" @bind="inputTitle" class="form-control" placeholder="Search Movie Title" id="inputTitle" />
		</div>

		<button class="btn btn-primary" style="margin-right: 5px" @onclick="LoadMovieByTitle">Search</button>
		<button class="btn btn-outline-primary" @onclick="LoadRandomMovie">Random</button>

		@if (movie != null)
		{
			<div class="card mt-3 mb-3" style="max-width: 100%; width: 100%">
				<div class="card-body" style="padding-bottom: 10px">
					<div class="mb-1" style="display: flex">
						<h2 class="card-title fw-bold mb-0" style="max-width: 30em; margin-right: 10px">@movie.Title</h2>
						<div class="wrapper" style="min-width: 114px; max-height: 40px; float: right; line-height: 1; display: inline-block">
							<img src="https://images.emojiterra.com/twitter/v13.1/512px/2b50.png" style="float: left; margin-right: 7px; max-height: 35px; max-width: 35px" />
							<div class="mb-0" style="float: left">
								<div class="mb-0">
									<span style="font-size: 24px; font-weight: bolder">@movie.Rating</span>
									<span style="font-size: 16px; vertical-align: baseline">/10</span>
								</div>
								<div class="mb-0" style="font-size: 14px">@FormatNumber(movie.Votes) votes</div>
							</div>

						</div>
					</div>
					<div class="mb-1">
						@movie.MPAA_Rating &nbsp | &nbsp @(movie.RunTime / 60)h @(movie.RunTime % 60)m &nbsp | &nbsp @movie.Release_Date.ToString("dd MMMM yyyy")
					</div>
					@if (movie.Genres != null)
					{
						<div class="mb-1" style="display: flex">
							@foreach (GenreModel genre in movie.Genres)
							{
								<div class="box" style="margin-right: 0.25rem">
									@genre.Genre
								</div>
							}
						</div>
					}
					<p class="card-text">@movie.Description</p>
					<div class="card-footer" style="display: flex; padding-left: 0; padding-bottom: 0">
						<div class="mb-0" style="margin-right: 5px">
							<input type="text" @bind="inputRating" class="form-control" placeholder="Leave a rating" id="inputRating" />
							<div class="validation-message" id="validation-message" style="visibility: hidden;font-size: 12px">Please enter a rating between 1 and 10.</div>
						</div>

						<button class="btn btn-primary" style="height: min-content" @onclick="SubmitRating" id="submitButton">Submit</button>
					</div>
				</div>
			</div>
		}

		<h3>Recommendations</h3>

		@if (recommendedMovies != null)
		{
			@foreach (MovieModel movie in recommendedMovies)
			{
				<div class="card mt-3 mb-3" style="max-width: 100%; width: 100%">
					<div class="card-body" style="padding-bottom: 10px">
						<div class="mb-1" style="display: flex">
							<h2 class="card-title fw-bold mb-0" style="max-width: 30em; margin-right: 10px">@movie.Title</h2>
							<div class="wrapper" style="min-width: 114px; max-height: 40px; float: right; line-height: 1; display: inline-block">
								<img src="https://images.emojiterra.com/twitter/v13.1/512px/2b50.png" style="float: left; margin-right: 7px; max-height: 35px; max-width: 35px" />
								<div class="mb-0" style="float: left">
									<div class="mb-0">
										<span style="font-size: 24px; font-weight: bolder">@movie.Rating</span>
										<span style="font-size: 16px; vertical-align: baseline">/10</span>
									</div>
									<div class="mb-0" style="font-size: 14px">@FormatNumber(movie.Votes) votes</div>
								</div>

							</div>
						</div>
						<div class="mb-1">
							@movie.MPAA_Rating &nbsp | &nbsp @(movie.RunTime / 60)h @(movie.RunTime % 60)m &nbsp | &nbsp @movie.Release_Date.ToString("dd MMMM yyyy")
						</div>
						@if (movie.Genres != null)
						{
							<div class="mb-1" style="display: flex">
								@foreach (GenreModel genre in movie.Genres)
								{
									<div class="box" style="margin-right: 0.25rem">
										@genre.Genre
									</div>
								}
							</div>
						}
						<p class="card-text">@movie.Description</p>
					</div>
				</div>
			}
		}

		<script>

			function ValidateRatingMessage(isValid) {
				if (isValid) {
					document.getElementById("inputRating").value = "";
					document.getElementById("inputRating").classList.remove("invalid");
					document.getElementById("validation-message").style.visibility = "hidden";
				} else {
					document.getElementById("inputRating").classList.add("invalid");
					document.getElementById("validation-message").style.visibility = "visible";
				}
			}

		</script>
	</Authorized>
	<NotAuthorized>
		<h3>Log in to view your recommendations.</h3>
	</NotAuthorized>
</AuthorizeView>


@code {

	private string inputTitle { get; set; } = "";
	private string inputRating { get; set; } = "";

	List<MovieModel> recommendedMovies = new List<MovieModel>();
	MovieModel movie = new MovieModel();

	public async void SubmitRating() {
		bool isDouble = Double.TryParse(inputRating, out double userRating);

		if (userRating >= 1 && userRating <= 10)
		{
			await JS.InvokeVoidAsync("ValidateRatingMessage", true);
			int userID = Int32.Parse(httpContextAccessor.HttpContext.User.FindFirst(ClaimTypes.NameIdentifier).Value);

			if (await _dbRating.GetRating(userID, movie.Movie_ID) != null)
			{
				_dbRating.UpdateRating(userID, movie.Movie_ID, userRating);
			} else
			{
				_dbRating.CreateRating(userID, movie.Movie_ID, userRating);
			}
			return;
		}

		await JS.InvokeVoidAsync("ValidateRatingMessage", false);

	}

	public async void LoadRandomMovie()
	{
		Random random = new Random();
		int randomID = random.Next(1, 32262);

		movie = await _db.GetMovieByID(randomID);
		StateHasChanged();
	}

	public async void LoadMovieByTitle()
	{
		if (!inputTitle.Equals(""))
		{
			List<MovieModel> movies = await _db.GetMoviesByTitle(inputTitle, 0, 1);
			movie = movies[0];
		}
		StateHasChanged();
	}

	public async void LoadRecommendations() {
		int userID = Int32.Parse(httpContextAccessor.HttpContext.User.FindFirst(ClaimTypes.NameIdentifier).Value);
		recommendedMovies = await _dbRating.GetUserRecommendations(userID, 3);
		StateHasChanged();
	}

	private static string FormatNumber(long num)
	{
		long i = (long)Math.Pow(10, (int)Math.Max(0, Math.Log10(num) - 2));
		num = num / i * i;

		if (num >= 1000000000)
			return (num / 1000000000D).ToString("0.##") + "B";
		if (num >= 1000000)
			return (num / 1000000D).ToString("0.##") + "M";
		if (num >= 1000)
			return (num / 1000D).ToString("0.##") + "K";

		return num.ToString("#,0");
	}

	protected override async Task OnInitializedAsync()
	{
		LoadRecommendations();
		LoadRandomMovie();
	}

}
